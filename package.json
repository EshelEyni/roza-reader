{
  "name": "roza-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p client && tsc -p server && tsc -p electron",
    "build:electron": "node electron/build.mjs",
    "electron:dev": "npm run build:electron && node electron/dev.mjs",
    "electron": "npm run build && npm run build:electron && electron .",
    "package": "npm run build && npm run build:electron && electron-builder --dir",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:speech": "tsx scripts/speech-smoke.ts",
    "test:offline": "tsx scripts/offline-smoke.ts"
  },
  "build": {
    "appId": "com.roza.reader",
    "productName": "RozaReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "client/dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "kokoro",
        "to": "kokoro",
        "filter": [
          "service.py",
          "setup.sh",
          "setup.ps1"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.books",
      "icon": "assets/icon.png"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "description": "RozaReader EPUB reader with Kokoro narration and audiobook export",
  "author": "EshelEyni"
}
